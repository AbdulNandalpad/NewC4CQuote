{
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/pricing/(.*)$",
      "target": "/pricing/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": false
    },
    {
      "source": "^/(.*)$",
      "target": "/$1",
      "destination": "pricing-ui",
      "authenticationType": "xsuaa"
    }
  ]
}
